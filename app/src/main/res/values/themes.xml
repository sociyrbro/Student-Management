<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        App 内所有文字统一为绿色：
        1) 主题里改 textColorPrimary / textColorSecondary / textColorHint；
        2) 每个布局中的 TextView / EditText / Button 再显式指定 textColor，避免个别控件走默认色。
    -->
    <style name="Theme.StudentManagement" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_primary</item>
        <item name="colorControlActivated">@color/green_primary</item>
        <item name="colorAccent">@color/green_primary</item>

        <item name="android:textColorPrimary">@color/text_green</item>
        <item name="android:textColorSecondary">@color/text_green_secondary</item>
        <item name="android:textColorHint">@color/green_hint</item>

        <item name="android:statusBarColor">@color/green_primary</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="actionBarStyle">@style/GreenActionBar</item>
    </style>

    <!-- ActionBar：浅绿底 + 深绿标题 -->
    <style name="GreenActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/green_light</item>
        <item name="titleTextStyle">@style/GreenActionBarTitle</item>
        <item name="subtitleTextStyle">@style/GreenActionBarTitle</item>
    </style>

    <style name="GreenActionBarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_green</item>
    </style>

    <!-- 表单输入框：绿色下划线、绿色文字与提示 -->
    <style name="GreenEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/text_green</item>
        <item name="android:textColorHint">@color/green_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:backgroundTint">@color/green_primary</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

</resources>
